# ---- Gateway (backend) ----
PORT=

# OpenSky Network (flights) — optional. Anonymous works but is heavily rate-limited.
# Create a free account at https://opensky-network.org for higher limits.
OPENSKY_USER=
OPENSKY_PASS=

# CelesTrak satellite group (TLE source). Examples: visual, stations, active, starlink, gps-ops
SAT_GROUP=

# Windy Webcams API (public webcams) — optional. Get a key at https://api.windy.com/keys
WINDY_WEBCAMS_KEY=

# AISStream.io (vessels) — optional. Free key at https://aisstream.io
AISSTREAM_KEY=

# ---- Web (frontend, must be prefixed with VITE_) ----
# Cesium ion token (terrain, 3D buildings, base imagery). Free at https://cesium.com/ion
VITE_CESIUM_ION_TOKEN=
# Google Photorealistic 3D Tiles key — optional (photoreal global 3D geometry).
VITE_GOOGLE_3DTILES_KEY=
# Mapillary token (open street-level imagery). Free at https://www.mapillary.com/dashboard/developers
VITE_MAPILLARY_TOKEN=
# Gateway URLs the frontend connects to.
VITE_GATEWAY_HTTP=
VITE_GATEWAY_WS=
